{
  "sources": {
    "teammates": true,
    "my_mic": false
  },
  "capture": {
    "cs2_process_name": "cs2.exe",
    "teammates_backend": "process",
    "fallback_to_loopback": true
  },
  "chat": {
    "enabled": true,
    "console_log_path": "",
    "scopes": [
      "ALL",
      "TEAM"
    ],
    "translate": true,
    "translator": "google"
  },
  "stt": {
    "device": "auto",
    "gpu_model": "medium",
    "cpu_model": "small",
    "gpu_busy_threshold": 95,
    "cpu_compute_type": "int8",
    "gpu_compute_type": "float16",
    "cpu_threads": 4,
    "beam_size": 5
  },
  "translation": {
    "enabled": true,
    "engine": "whisper",
    "target_language": "English",
    "only_foreign": true,
    "only_foreign_min_prob": 0.6,
    "translate_sources": [
      "teammates"
    ],
    "show_original": false,
    "lmstudio": {
      "base_url": "http://localhost:1234/v1",
      "model": "local-model",
      "api_key": "lm-studio"
    }
  },
  "vad": {
    "aggressiveness": 2,
    "silence_ms": 500,
    "max_utterance_s": 6,
    "min_speech_ms": 200,
    "min_chars": 2,
    "preroll_ms": 300
  },
  "diarization": {
    "enabled": true,
    "similarity_threshold": 0.6,
    "max_speakers": 5
  },
  "overlay": {
    "enabled": false,
    "max_lines": 5,
    "font_size": 20,
    "x": 40,
    "y": 40,
    "width": 720,
    "line_ttl_s": 12,
    "click_through": true
  },
  "history": {
    "enabled": true,
    "max_lines": 500
  },
  "hotkeys": {
    "enabled": true,
    "toggle_pause": "ctrl+alt+p",
    "toggle_overlay": "ctrl+alt+o",
    "show_window": "ctrl+alt+c"
  },
  "transcript": {
    "enabled": false,
    "directory": ""
  }
}
