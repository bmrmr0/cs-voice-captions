# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.Python

# --- Virtual environments ---
.venv/
venv/
env/

# --- PyInstaller output (the exe is ~200 MB; ship it via Releases) ---
build/
dist/
dist-*/
release/
# generated by build.py, and contains absolute build-machine paths
*.spec

# --- Runtime / user data ---
# Normally all of this lives in %LOCALAPPDATA%\CSVoiceCaptions, but run from
# source in portable mode it lands in this folder -- and it is private:
# saved clips are recordings of other players' voices, transcripts and the
# log hold their names and chat.
config.json
portable.txt
clips/
transcripts/
device-cache/
captions-*.txt
captions-*.log
*.log
# an inherited earlier build, with another machine's paths baked in
old/

# --- Models / caches ---
.cache/
models/
*.bin
*.onnx

# --- Editors & OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Intel PresentMon, downloaded for tools/perf_record.py
tools/PresentMon*.exe
