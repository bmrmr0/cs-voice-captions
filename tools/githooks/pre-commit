#!/bin/sh
# Refuses the lines a commit adds if it would publish private data: text pasted from
# CS2's chat log, other players' names, this machine's paths or name, or
# secrets. See tools/privacy_check.py. Enabled per clone with:
#     git config core.hooksPath tools/githooks
root=$(git rev-parse --show-toplevel)
py="$root/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$root/.venv/bin/python"
[ -x "$py" ] || py=python
PYTHONIOENCODING=utf-8 exec "$py" "$root/tools/privacy_check.py" --staged
